<Project Sdk="Microsoft.NET.Sdk">

  <!-- DEBUG HARNESS (throwaway): drives the real PickComputation over a synthetic territory
       graph and asserts every pick comes from a territory within the configured range.
       Not part of the mod build (the mod csproj excludes scripts/**). -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <LangVersion>7.3</LangVersion>
    <Nullable>disable</Nullable>
    <AssemblyName>Rangecircuit</AssemblyName>
    <RootNamespace>Rangecircuit</RootNamespace>
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
    <NoWarn>CS0436;CS0618;MSB3277;CS0649</NoWarn>
  </PropertyGroup>


  <ItemGroup>
    <Compile Include="Program.cs" />
    <Compile Include="PluginShim.cs" />
    <Compile Include="..\..\PickComputation.cs" />
    <Compile Include="..\..\GameSurface.cs" />
    <Compile Include="..\..\GameApi.cs" />
  </ItemGroup>

  <ItemGroup>
    <!-- Game + BepInEx assemblies from the private GameLibs feed (nuget.config
         inheritance from repo root): version pin = game build. Runtime copies are
         Private=true equivalents: the harness runs headless against these DLLs. -->
    <PackageReference Include="Humankind.GameLibs" Version="[1.0.31.4851-r2]" />
  </ItemGroup>

</Project>
