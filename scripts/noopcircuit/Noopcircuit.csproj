<Project Sdk="Microsoft.NET.Sdk">

  <!-- NO-OP / SHOWN-SET CONTRACT HARNESS: drives the real Advisor, EvaluationWriter, PickSet,
       both Harmony postfixes and vanilla's own pin filter chain over a synthetic surface and
       snapshot. Asserts the advisor writes nothing on a mode it does not own, keeps its
       settlement tail, publishes its membership as the shown set, and displays nothing when
       INACTIVE. Not part of the mod build; Plugin.cs is replaced by PluginShim.cs. -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <LangVersion>7.3</LangVersion>
    <Nullable>disable</Nullable>
    <AssemblyName>Noopcircuit</AssemblyName>
    <RootNamespace>Noopcircuit</RootNamespace>
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
    <NoWarn>CS0436;CS0618;MSB3277;CS0649</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <Compile Include="Program.cs" />
    <Compile Include="PluginShim.cs" />
    <Compile Include="..\..\Advisor.cs" />
    <Compile Include="..\..\AdvisorConfig.cs" />
    <Compile Include="..\..\EvaluationWriter.cs" />
    <Compile Include="..\..\GameApi.cs" />
    <Compile Include="..\..\GameSurface.cs" />
    <Compile Include="..\..\Patches.cs" />
    <Compile Include="..\..\PickComputation.cs" />
    <Compile Include="..\..\PickSet.cs" />
    <Compile Include="..\..\StarRenderer.cs" />
  </ItemGroup>

  <ItemGroup>
    <!-- Game + BepInEx assemblies from the private GameLibs feed, same pin as the mod. -->
    <PackageReference Include="Humankind.GameLibs" Version="[1.0.31.4851-r2]" />
  </ItemGroup>

</Project>
