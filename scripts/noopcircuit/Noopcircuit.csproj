<Project Sdk="Microsoft.NET.Sdk">

  <!-- WRITE-SIDE / SHOWN-SET CONTRACT HARNESS: drives the real Advisor, EvaluationWriter, PickSet,
       both Harmony postfixes and vanilla's own pin filter chain over a synthetic surface and
       snapshot. Asserts the advisor writes through the active mode's pipeline into that mode's
       evaluation only, scrubs the tail an activation inherits in every mode, publishes its
       membership as the shown set, displays nothing when INACTIVE, and writes nothing in a mode
       the mode-policy table has not wired. Not part of the mod build; Plugin.cs is PluginShim.cs. -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <LangVersion>7.3</LangVersion>
    <Nullable>disable</Nullable>
    <AssemblyName>Noopcircuit</AssemblyName>
    <RootNamespace>Noopcircuit</RootNamespace>
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
    <NoWarn>CS0436;CS0618;MSB3277;CS0649</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <Compile Include="Program.cs" />
    <Compile Include="PluginShim.cs" />
    <Compile Include="..\..\Advisor.cs" />
    <Compile Include="..\..\AdvisorConfig.cs" />
    <Compile Include="..\..\EvaluationWriter.cs" />
    <Compile Include="..\..\GameApi.cs" />
    <Compile Include="..\..\GameSurface.cs" />
    <Compile Include="..\..\Patches.cs" />
    <Compile Include="..\..\PickComputation.cs" />
    <Compile Include="..\..\PickSet.cs" />
    <Compile Include="..\..\StarRenderer.cs" />
  </ItemGroup>

  <ItemGroup>
    <!-- Game + BepInEx assemblies from the private GameLibs feed, same pin as the mod. -->
    <PackageReference Include="Humankind.GameLibs" Version="[1.0.31.4851-r2]" />
  </ItemGroup>

</Project>
