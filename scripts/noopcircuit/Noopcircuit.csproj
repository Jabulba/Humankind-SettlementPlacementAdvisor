<Project Sdk="Microsoft.NET.Sdk">

  <!-- NO-OP CONTRACT HARNESS: drives the real Advisor, EvaluationWriter, PickSet and the two
       Harmony postfixes over a synthetic game surface and a synthetic snapshot, and asserts
       the advisor is a strict no-op on every non-camp placement evaluation, that camp
       placement still writes its tail, and that the pin gate hands vanilla back when the
       advisor is inactive. Not part of the mod build (the mod csproj excludes scripts/**).
       Plugin.cs is replaced by PluginShim.cs: the headless stand-in for Plugin. -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <LangVersion>7.3</LangVersion>
    <Nullable>disable</Nullable>
    <AssemblyName>Noopcircuit</AssemblyName>
    <RootNamespace>Noopcircuit</RootNamespace>
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
    <NoWarn>CS0436;CS0618;MSB3277;CS0649</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <Compile Include="Program.cs" />
    <Compile Include="PluginShim.cs" />
    <Compile Include="..\..\Advisor.cs" />
    <Compile Include="..\..\AdvisorConfig.cs" />
    <Compile Include="..\..\EvaluationWriter.cs" />
    <Compile Include="..\..\GameApi.cs" />
    <Compile Include="..\..\GameSurface.cs" />
    <Compile Include="..\..\Patches.cs" />
    <Compile Include="..\..\PickComputation.cs" />
    <Compile Include="..\..\PickSet.cs" />
    <Compile Include="..\..\StarRenderer.cs" />
  </ItemGroup>

  <ItemGroup>
    <!-- Game + BepInEx assemblies from the private GameLibs feed (nuget.config inheritance
         from the repo root): version pin = game build, same as the mod and range harnesses. -->
    <PackageReference Include="Humankind.GameLibs" Version="[1.0.31.4851-r2]" />
  </ItemGroup>

</Project>
