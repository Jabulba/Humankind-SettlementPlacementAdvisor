<Project Sdk="Microsoft.NET.Sdk">

  <!-- RELEASE CONFIG GENERATOR (Q8: wrapper on Config): runs the production
       AdvisorConfig.Bind against a fresh BepInEx Config and writes the
       pre-generated cfg shipped in releases, byte-shaped like the game-written
       file. Same pattern as the rangecircuit harness: production sources,
       no copies. Not part of the mod build (the mod csproj excludes scripts/**). -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <LangVersion>7.3</LangVersion>
    <Nullable>disable</Nullable>
    <AssemblyName>CfgGen</AssemblyName>
    <RootNamespace>CfgGen</RootNamespace>
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
    <NoWarn>CS0436;CS1701;CS1702;MSB3277</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <Compile Include="Program.cs" />
    <Compile Include="..\..\AdvisorConfig.cs" />
  </ItemGroup>
  <ItemGroup>
    <!-- BepInEx ConfigFile from the GameLibs feed (same shipped assembly the game
         writes configs with; runtime asset needed, headless tool). -->
    <PackageReference Include="Humankind.GameLibs" Version="[1.0.31.4851-r2]" />
  </ItemGroup>


</Project>
