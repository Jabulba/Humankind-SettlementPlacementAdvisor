<Project Sdk="Microsoft.NET.Sdk">

    <!-- BUILD-TIME VERSION READER, not plugin source: the plugin build's GenerateModVersion target
         and tools/CfgGen compile this reader, and tests compile it to pin its decode contract. It
         stamps GameBuild.Supported from the assembly-level Version attribute of the
         Assembly-CSharp.dll its caller is given (the package copy in feed mode, the install copy in
         local mode, the cfg writer's own output copy in tools/CfgGen). That attribute is what
         Amplitude.Framework.Application LoadVersionFromAssemblyAttribute fills at runtime, and
         Humankind-GameLibs' derive tool reads it with the same decoder, so a staged set, a resolved
         reference set and the cfg writer's copy report one number.
         System.Reflection.MetadataLoadContext is the only dependency: attribute values come out of
         the metadata, no assembly is loaded, no module initializer runs.
         LocalGameLibs=false keeps the root Directory.Build.props game-reference injection off this
         project: MSBuild evaluates every PropertyGroup before any ItemGroup, so this value is in force
         when the props' item condition is evaluated (measured: 0 Reference items here, 572 in the
         plugin project). Build through the plugin build, which passes it as a global property too.
         Run: dotnet bin/Release/net10.0/GameBuild.dll <game-assembly.dll> -->
    <PropertyGroup>
        <OutputType>Exe</OutputType>
        <TargetFramework>net10.0</TargetFramework>
        <AssemblyName>GameBuild</AssemblyName>
        <RootNamespace>GameBuildTool</RootNamespace>
        <Nullable>disable</Nullable>
        <InvariantGlobalization>true</InvariantGlobalization>
        <IsPackable>false</IsPackable>
        <LocalGameLibs>false</LocalGameLibs>
    </PropertyGroup>

    <ItemGroup>
        <PackageReference Include="System.Reflection.MetadataLoadContext" Version="9.0.0"/>
    </ItemGroup>

</Project>
