<?xml version="1.0" encoding="utf-8"?>
<configuration>
    <packageSources>
        <add key="nuget.org" value="https://api.nuget.org/v3/index.json"/>
        <add key="gamelibs" value="https://nuget.pkg.github.com/Jabulba/index.json"/>
    </packageSources>
    <packageSourceCredentials>
        <gamelibs>
            <add key="Username" value="x-token"/>
            <add key="ClearTextPassword" value="%GAMELIBS_PAT%"/>
        </gamelibs>
    </packageSourceCredentials>
</configuration>
