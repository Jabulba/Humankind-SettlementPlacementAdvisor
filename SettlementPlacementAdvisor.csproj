<Project Sdk="Microsoft.NET.Sdk">

  <!-- Settlement placement advisor. Build: scripts/build-advisor.sh. Rules: README.md.
       Module vocabulary: GLOSSARY.md. -->
  <PropertyGroup>
    <TargetFramework>net472</TargetFramework>
    <LangVersion>7.3</LangVersion>
    <AssemblyName>SettlementPlacementAdvisor</AssemblyName>
    <RootNamespace>SettlementPlacementAdvisor</RootNamespace>
    <AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>
    <Nullable>disable</Nullable>
    <DebugType>none</DebugType>
    <!-- No <Version>: MinVer stamps it from git tags. The game ships its own copies of the
         referenced assemblies, so references stay out of the output. CS0436 stays enabled: it
         is the loud signal for decompiled game sources leaking into this compile. -->
    <NoWarn>CS0618</NoWarn>
  </PropertyGroup>

  <!-- Harness sources live under scripts/ (own projects) and the decompiled game cache under
       reference/ (gitignored): keep both out of this project's default item globs. -->
  <ItemGroup>
    <Compile Remove="scripts/**/*.cs" />
    <Compile Remove="reference/**/*.cs" />
    <None Remove="reference/**" />
  </ItemGroup>

  <!-- Game install path, resolved per machine: -p:GameDir=... wins, then GAME_DIR (the same
       knob scripts/launch-game.sh reads), then the standard Steam Linux install. -->
  <PropertyGroup>
    <!-- GetEnvironmentVariable, not $(Env:GAME_DIR): the SDK's MSBuild returns an empty
         string for Env:, which silently falls through to the default. -->
    <GameDir Condition="'$(GameDir)' == ''">$([System.Environment]::GetEnvironmentVariable('GAME_DIR'))</GameDir>
    <GameDir Condition="'$(GameDir)' == ''">$([System.Environment]::GetFolderPath(SpecialFolder.UserProfile))/.local/share/Steam/steamapps/common/Humankind</GameDir>
    <BepInExPluginsDir>$(GameDir)/BepInEx/plugins</BepInExPluginsDir>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NETFramework.ReferenceAssemblies" Version="1.0.3" PrivateAssets="all" />
    <PackageReference Include="MinVer" Version="8.0.0" PrivateAssets="all" />
    <!-- Compile-time game + BepInEx assemblies from the private GameLibs feed
         (nuget.config; CONTRIBUTING.md). Version = game build; runtime assets excluded
         because the game ships its own copies. -->
    <PackageReference Include="Humankind.GameLibs" Version="[1.0.31.4851-r2]" PrivateAssets="all" ExcludeAssets="runtime" />
  </ItemGroup>


  <!-- Deploy only when the install exists; the skip is loud so a missing game never looks
       like a successful deploy. -->
  <Target Name="CopyToPlugins" AfterTargets="Build">
    <Message Importance="high" Condition="!Exists('$(GameDir)')"
             Text="GameDir '$(GameDir)' not found: $(TargetFileName) NOT deployed (pass -p:GameDir=... or export GAME_DIR)" />
    <MakeDir Condition="Exists('$(GameDir)')" Directories="$(BepInExPluginsDir)" />
    <Copy Condition="Exists('$(GameDir)')" SourceFiles="$(TargetPath)" DestinationFolder="$(BepInExPluginsDir)" />
    <Message Importance="high" Condition="Exists('$(GameDir)')" Text="Copied $(TargetFileName) -> $(BepInExPluginsDir)" />
  </Target>

  <!-- MinVer's computed version becomes the compile-time constant consumed by the
       BepInPlugin attribute, keeping git tags the single source. -->
  <Target Name="GenerateModVersion" BeforeTargets="CoreCompile">
    <PropertyGroup>
      <_ModVersionSource>internal static class ModVersion
{
    public const string Value = "$(Version)"%3B
}</_ModVersionSource>
    </PropertyGroup>
    <WriteLinesToFile File="$(IntermediateOutputPath)modversion.g.cs" Lines="$(_ModVersionSource)" Overwrite="true" WriteOnlyWhenDifferent="true" />
    <ItemGroup>
      <Compile Include="$(IntermediateOutputPath)modversion.g.cs" />
    </ItemGroup>
  </Target>

</Project>
