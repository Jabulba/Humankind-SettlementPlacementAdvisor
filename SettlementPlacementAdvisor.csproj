<Project Sdk="Microsoft.NET.Sdk">

  <!-- Settlement placement advisor. Build: scripts/build-advisor.sh. Rules: README.md.
       Module vocabulary: GLOSSARY.md. -->
  <PropertyGroup>
    <TargetFramework>net472</TargetFramework>
    <LangVersion>7.3</LangVersion>
    <AssemblyName>SettlementPlacementAdvisor</AssemblyName>
    <RootNamespace>SettlementPlacementAdvisor</RootNamespace>
    <AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>
    <Nullable>disable</Nullable>
    <DebugType>none</DebugType>
    <!-- MinVer stamps the version from git tags. MinVerMinimumMajorMinor is the untagged
         fallback (the default 0.0 makes untagged builds compute 0.0.0-alpha.0.<n>, a form
         BepInEx 5 cannot parse, which silently skips the whole plugin; see the
         GenerateModVersion guard below). The game ships its own copies of the referenced
         assemblies, so references stay out of the output. CS0436 stays enabled: it is the loud
         signal for decompiled game sources leaking into this compile. -->
    <MinVerMinimumMajorMinor>1.0</MinVerMinimumMajorMinor>
    <NoWarn>CS0618</NoWarn>
  </PropertyGroup>

  <!-- Harness sources live under scripts/ (own projects) and the decompiled game cache under
       reference/ (gitignored): keep both out of this project's default item globs. -->
  <ItemGroup>
    <Compile Remove="scripts/**/*.cs" />
    <Compile Remove="reference/**/*.cs" />
    <None Remove="reference/**" />
  </ItemGroup>

  <!-- Game install path, resolved per machine: -p:GameDir=... wins, then GAME_DIR (the same
       knob scripts/launch-game.sh reads), then the standard Steam Linux install. -->
  <PropertyGroup>
    <!-- GetEnvironmentVariable, not $(Env:GAME_DIR): the SDK's MSBuild returns an empty
         string for Env:, which silently falls through to the default. -->
    <GameDir Condition="'$(GameDir)' == ''">$([System.Environment]::GetEnvironmentVariable('GAME_DIR'))</GameDir>
    <GameDir Condition="'$(GameDir)' == ''">$([System.Environment]::GetFolderPath(SpecialFolder.UserProfile))/.local/share/Steam/steamapps/common/Humankind</GameDir>
    <BepInExPluginsDir>$(GameDir)/BepInEx/plugins</BepInExPluginsDir>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NETFramework.ReferenceAssemblies" Version="1.0.3" PrivateAssets="all" />
    <PackageReference Include="MinVer" Version="8.0.0" PrivateAssets="all" />
    <!-- Compile-time game + BepInEx assemblies from the private GameLibs feed
         (nuget.config; CONTRIBUTING.md). Version = game build; runtime assets excluded
         because the game ships its own copies. -->
    <PackageReference Include="Humankind.GameLibs" Version="[1.0.31.4851-r2]" PrivateAssets="all" ExcludeAssets="runtime" />
  </ItemGroup>


  <!-- Deploy only when the install exists; the skip is loud so a missing game never looks
       like a successful deploy. -->
  <Target Name="CopyToPlugins" AfterTargets="Build">
    <Message Importance="high" Condition="!Exists('$(GameDir)')"
             Text="GameDir '$(GameDir)' not found: $(TargetFileName) NOT deployed (pass -p:GameDir=... or export GAME_DIR)" />
    <MakeDir Condition="Exists('$(GameDir)')" Directories="$(BepInExPluginsDir)" />
    <Copy Condition="Exists('$(GameDir)')" SourceFiles="$(TargetPath)" DestinationFolder="$(BepInExPluginsDir)" />
    <Message Importance="high" Condition="Exists('$(GameDir)')" Text="Copied $(TargetFileName) -> $(BepInExPluginsDir)" />
  </Target>

  <!-- MinVer's computed version becomes the compile-time constant consumed by the
       BepInPlugin attribute, keeping git tags the single source.
       BepInEx 5 parses that attribute string with new System.Version(...): only dot-separated
       numbers parse, so a pre-release ("1.0.0-alpha.0.3") or build-metadata ("+g1234abc")
       suffix makes the version null and BepInEx SKIPS THE WHOLE PLUGIN: "Skipping type
       [SettlementPlacementAdvisor.Plugin] because its version is invalid", no patches, no
       advisor. Therefore: sanitize to the numeric core (strip "+metadata", then "-prerelease")
       and guard the build so no unparseable stamp can ever ship. -->
  <Target Name="GenerateModVersion" BeforeTargets="CoreCompile">
    <PropertyGroup>
      <_ModVersionCore>$([System.Text.RegularExpressions.Regex]::Replace('$(Version)', '\\+.*$', ''))</_ModVersionCore>
      <_ModVersionCore>$([System.Text.RegularExpressions.Regex]::Replace('$(_ModVersionCore)', '-.*$', ''))</_ModVersionCore>
      <!-- Major >= 1 and three numeric segments: what the BepInPlugin constructor's
           new System.Version(string) accepts (BepInEx 5 loads 0.x if the core parses, so a
           positive major is also required; MinVer's untagged default 0.0.0 must never ship).
           MSBuild statics have no out parameters, so the guard replicates the parser. -->
      <_ModVersionParsable>$([System.Text.RegularExpressions.Regex]::IsMatch('$(_ModVersionCore)', '^([1-9]\d*)\.(0|[1-9]\d*)\.(0|[1-9]\d*)$'))</_ModVersionParsable>
    </PropertyGroup>
    <Error Condition="'$(_ModVersionParsable)' != 'True'"
           Text="BepInPlugin version '$(Version)' sanitizes to '$(_ModVersionCore)': BepInEx 5 needs a numeric major>=1.minor.build core (untagged builds need MinVerMinimumMajorMinor >= 1.0)." />
    <Message Importance="high" Text="ModVersion for BepInPlugin: $(_ModVersionCore) (MinVer '$(Version)')" />
    <PropertyGroup>
      <_ModVersionSource>internal static class ModVersion
{
    public const string Value = "$(_ModVersionCore)"%3B
}</_ModVersionSource>
    </PropertyGroup>
    <WriteLinesToFile File="$(IntermediateOutputPath)modversion.g.cs" Lines="$(_ModVersionSource)" Overwrite="true" WriteOnlyWhenDifferent="true" />
    <ItemGroup>
      <Compile Include="$(IntermediateOutputPath)modversion.g.cs" />
    </ItemGroup>
  </Target>

</Project>
